{
  "camera_human_detected_log": {
    "name": "Camera human detected (log only)",
    "enabled": true,
    "trigger": "event:camera_automation.camera_event",
    "conditions": [
      {
        "type": "equals",
        "target": "event.kind",
        "value": "human_detected"
      }
    ],
    "actions": [
      {
        "type": "automation.log",
        "parameters": {
          "message": "camera_automation.camera_event kind=human_detected matched (log-only, no device action)"
        }
      }
    ],
    "cooldown_seconds": 0.0,
    "execution_policy": "no_partial",
    "sequence": [],
    "description": "",
    "created_at": null,
    "updated_at": null
  },
  "camera_human_detected_test_action": {
    "name": "Camera human PRESENCE CONFIRMED -> RGB Strip light ON (P0.8.6 - gated on sustained, high-confidence detection, not a single raw frame)",
    "enabled": false,
    "trigger": "event:camera_automation.camera_event",
    "conditions": [
      {
        "type": "equals",
        "target": "event.kind",
        "value": "human_confirmed"
      },
      {
        "type": "equals",
        "target": "event.available",
        "value": true
      },
      {
        "type": "equals",
        "target": "event.detection_error",
        "value": null
      }
    ],
    "actions": [
      {
        "type": "home_assistant.turn_on",
        "parameters": {
          "target": "light.wled"
        }
      }
    ],
    "cooldown_seconds": 30.0,
    "execution_policy": "no_partial",
    "sequence": [],
    "description": "",
    "created_at": null,
    "updated_at": null
  },
  "camera_multiple_people_log": {
    "name": "Camera multiple people detected (log only, P0.7 Vision Context example)",
    "enabled": true,
    "trigger": "event:camera_automation.camera_event",
    "conditions": [
      {
        "type": "equals",
        "target": "event.kind",
        "value": "human_detected"
      },
      {
        "type": "greater_equal",
        "target": "event.person_count",
        "value": 2
      }
    ],
    "actions": [
      {
        "type": "automation.log",
        "parameters": {
          "message": "camera_automation.camera_event kind=human_detected with event.person_count >= 2 (Vision Context, log-only, no device action)"
        }
      }
    ],
    "cooldown_seconds": 0.0,
    "execution_policy": "no_partial",
    "sequence": [],
    "description": "",
    "created_at": null,
    "updated_at": null
  },
